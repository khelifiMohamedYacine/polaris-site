# Copy this file to .env.local and fill in the real values.
# These come from your Supabase project: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — NEVER expose this in the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket used for property photos (created in Supabase Storage)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=property-images

# Email notifications (optional). Leave empty to disable email sending —
# inquiries are still saved in the database either way.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=POLARIS Construction <notifications@yourdomain.dz>
NOTIFICATION_EMAIL_TO=contact@yourdomain.dz

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
