# Copy this file to .env.local for local development.

# PostgreSQL connection string. Leave it out locally to use the built-in
# embedded database stored in ./.data (nothing to install).
# DATABASE_URL=postgres://user:password@host:5432/polaris

# Admin account for /admin. Applied at every start-up, so changing
# ADMIN_PASSWORD and restarting is how the password is set or reset.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Signs the admin login cookie (any long random string, 16+ characters).
# Optional locally; required in production (Render generates it).
SESSION_SECRET=

# Email notifications (optional). Leave empty to disable email sending —
# inquiries are still saved in the database either way.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
